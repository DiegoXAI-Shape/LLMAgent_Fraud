# Copia este archivo a .env y llena los valores. .env está en .gitignore.
GEMINI_API_KEY=
# Medido contra la API real: 'gemini-2.5-pro' devuelve 429 (cuota agotada) y
# 'gemini-2.5-flash' devuelve 404 (ya no disponible). Repartir cualquiera de
# esos dos aquí dejaba el proyecto roto para quien clonara el repo.
GEMINI_MODEL=gemini-3.8-flash
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b
